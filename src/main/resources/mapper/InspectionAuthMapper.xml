<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jcd.mapper.InspectionAuthMapper" >
    <resultMap id="mesInspUsersResultMap" type="com.jcd.model.MesInspUsers">
        <id property="id" column="id"/>
        <result property="employeeId" column="employee_id"/>
        <result property="employeeName" column="employee_name"/>
        <result property="isActive" column="is_active"/>
    </resultMap>

    <resultMap id="permissionDetailResultMap" type="com.jcd.dto.UserPermissionInfoDto$PermissionDetail">
        <result property="site" column="site"/>
        <result property="roleCode" column="role_code"/>
        <result property="roleName" column="role_name"/>
        <result property="roleLevel" column="role_level"/>
    </resultMap>

    <!--
  查询1: 根据员工工号查找用户基础信息
  对应方法: MesInspUsers findUserByEmployeeId(String employeeId);
-->
    <select id="findUserByEmployeeId" resultMap="mesInspUsersResultMap">
        SELECT
            id,
            employee_id,
            employee_name,
            is_active
        FROM
            MES_INSP_USERS
        WHERE
            employee_id = #{employeeId}
    </select>


    <!--
      查询2: 根据用户ID查找其所有的权限分配详情 (关联角色表)
      对应方法: List<UserPermissionInfoDto.PermissionDetail> findPermissionsByUserId(String userId);
    -->
    <select id="findPermissionsByUserId" resultMap="permissionDetailResultMap">
        SELECT
            p.site,
            r.role_code,
            r.role_name,
            r.role_level
        FROM
            MES_INSP_USER_PERMISSIONS p
                JOIN
            MES_INSP_ROLES r ON p.role_id = r.id
        WHERE
            p.user_id = #{userId}
    </select>

    <select id="findBySite" resultType="com.jcd.model.MesInspDefectItems">
        SELECT
            id,
            site,
            defect_name as "defectName",
            display_order as "displayOrder"
        FROM
            MES_INSP_DEFECT_ITEMS
        WHERE
            site = #{site}
        ORDER BY
            display_order ASC, defect_name ASC
    </select>


</mapper>